# LLM API configuration for the advisory layers (quality review and report
# synthesis). Copy this file to .env and fill in your own key. Execution itself
# is deterministic and does not require a key; without one the two advisory
# LLM touches are skipped in their fail-safe mode.
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
